[Unit]
Description=Single-Tenant Trading Execution Engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/execution_engine
EnvironmentFile=/home/ubuntu/execution_engine/.env
ExecStart=/home/ubuntu/execution_engine/.venv/bin/python -u main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
