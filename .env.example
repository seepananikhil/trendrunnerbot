# ==============================================================================
# Single-Tenant Trading Execution Engine Configuration
# Copy this file to .env and fill in your personal credentials.
# NEVER commit .env to version control.
# ==============================================================================

# --- Execution Mode ---
# "paper" = simulated fills using real live broker quotes (safe default)
# "live"  = places real orders on Kotak Neo
TRADING_MODE=paper
TRADING_LOTS=1
SIZING_MODE=fixed
ORDER_PRODUCT=NRML

# --- Kotak Neo Broker Credentials (Single User) ---
# Ensure this VM's static public IP is whitelisted in your Kotak Neo API portal.
NEO_CONSUMER_KEY=
NEO_MOBILE_NUMBER=
NEO_UCC=
NEO_MPIN=
NEO_TOTP_SECRET=
NEO_ENVIRONMENT=prod

# --- Risk Guardian ---
RISK_GUARDIAN_ENABLED=true
RISK_GUARDIAN_AUTO_CLOSE=true
MAX_DAILY_LOSS=2000.0

# --- Telegram Notifications & Interactive Bot (Single User) ---
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Web Control Panel (Single-User) ---
WEB_PANEL_ENABLED=true
WEB_PANEL_PORT=8080
WEB_PANEL_PIN=change_me_1234

# --- Runtime ---
TZ=Asia/Kolkata
LOG_LEVEL=INFO
